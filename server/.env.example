# API server configuration.
# Copy to .env for local development. Never commit the real .env.

PORT=3000

# --- Clerk -------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Appwrite ----------------------------------------------------------------
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=cricket_form

# --- Analysis service --------------------------------------------------------
# The Python service is never exposed publicly; only this API talks to it.
ANALYSIS_SERVICE_URL=http://localhost:5000

# Shared secret between this API and the analysis service. Generate with:
#   openssl rand -hex 32
# Must be identical in both services. Both refuse to run without it rather than
# falling back to unauthenticated calls.
ANALYSIS_SHARED_SECRET=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
