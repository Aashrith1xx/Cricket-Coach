# Mobile app configuration.
# Copy to .env for local development.
#
# EXPO_PUBLIC_* variables are embedded in the client bundle and are readable by anyone
# with the app. Never put a secret here - the Appwrite API key and the analysis service
# shared secret belong on the server only.

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
